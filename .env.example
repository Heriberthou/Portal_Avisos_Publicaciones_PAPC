# =====================================================================
# PAPC | Plantilla de variables de entorno (SIN SECRETOS)
# Copia este archivo como ".env" en la raíz del proyecto (fuera de public/)
# y reemplaza los valores. El archivo .env está excluido del repositorio.
# =====================================================================

# desarrollo | produccion
# En "produccion" la cookie de sesión exige HTTPS (Secure + prefijo __Host-).
APP_ENTORNO=desarrollo

# Prefijo de URL de la aplicación:
#   /papc  -> XAMPP compartido con docs/xampp/papc.conf (http://IP/papc/)
#   vacío  -> VirtualHost cuyo DocumentRoot es public/ (http://papc.test/)
APP_RUTA_BASE=/papc

# Dirección pública COMPLETA del portal, sin barra final. Se usa para armar
# los enlaces de verificación, activación y recuperación de los correos.
# NUNCA se toma del encabezado Host de la petición (evita que un atacante
# envíe enlaces que apunten a su propio servidor).
APP_URL_PUBLICA=http://192.168.20.132/papc

# Envío de correos:
#   buzon_pruebas -> NO envía nada: guarda cada mensaje en storage/correos/
#                    (carpeta privada). Léelos con:
#                    php herramientas/ver-buzon-pruebas.php
#   mail          -> usa mail() de PHP; requiere configurar SMTP en php.ini.
#                    Si el envío falla, la interfaz lo dice (no finge envíos).
CORREO_MODO=buzon_pruebas
CORREO_REMITENTE=no-responder@papc.invalid

# Conexión a MariaDB. Valores del servidor XAMPP del laboratorio (192.168.20.132):
# base asignada equipo_7, cuenta usuario_equipo_7, MySQL en el puerto 3307.
# En una instalación local propia normalmente el puerto es 3306 y la base
# puede llamarse papc_db (ver README, Etapa 5).
# Si aparece "Access denied ...@'localhost'", revisa el usuario y la contraseña;
# como alternativa prueba DB_SERVIDOR=localhost.
DB_SERVIDOR=127.0.0.1
DB_PUERTO=3307
DB_NOMBRE=equipo_7
DB_USUARIO=usuario_equipo_7
DB_CONTRASENA=

# Clave secreta (64 caracteres hex) para:
#   - las huellas HMAC de intento_acceso,
#   - derivar (HKDF) la clave que cifra los secretos del segundo factor y la
#     que protege los códigos de recuperación.
# Si la cambias, los administradores deberán volver a configurar su
# segundo factor (herramientas/restablecer-segundo-factor.php).
# Genérala con:  php -r "echo bin2hex(random_bytes(32));"
CLAVE_HUELLAS=

# Cierre de sesión por inactividad, en segundos (E10-P07).
# Vacío = 1800 (30 minutos, política normal). Para la demostración ante los
# evaluadores puede bajarse a 120 (2 minutos). Rango aceptado: 60 a 1800;
# un valor fuera de rango se ignora y se usan los 30 minutos.
SESION_INACTIVIDAD_SEGUNDOS=
